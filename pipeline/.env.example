# Ingestion key for X-API-Key (24+ random characters). Also used by launcher.exe and the game build.
INGEST_KEY=replace-with-random-key-at-least-24-characters
# 127.0.0.1 = this PC only. Set 0.0.0.0 to accept the game from other PCs on the network (11.20 test).
COLLECTOR_BIND=127.0.0.1
# MongoDB port for the server part (read only). 127.0.0.1 = this PC only.
MONGO_BIND=127.0.0.1

# Optional tuning. Use separate ports/project for parallel v2 validation.
COLLECTOR_PORT=8000
MONGO_PORT=27017
SPARK_CORES=4
DEDUP_TTL_HOURS=168
# Experimental only: retain 0 until recovery and performance validation are complete.
SILVER_OPTIMIZATION_ENABLED=0
SILVER_MAX_MERGE_GROUPS=16
OUTBOX_STAGE_CHUNK=500
SPARK_DRIVER_MEMORY=2g
SHUFFLE_PARTITIONS=4
MAX_OFFSETS_PER_TRIGGER=10000
BRONZE_TRIGGER=5 seconds
STAGE_TRIGGER=1 second

# Optional local operations UI (profile: observatory)
OBSERVATORY_BIND=127.0.0.1
OBSERVATORY_PORT=8011
OBSERVATORY_NAME=NODEVERSE
OBSERVATORY_INTERVAL_S=10
# Set a separate private key before choosing a LAN bind. Never put it in Git.
OBSERVATORY_KEY=
